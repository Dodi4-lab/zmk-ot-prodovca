#include <behaviors/unicode.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2
#define UC_UP_ARROWHEAD 0x2303 0  // ⌃
#define UC_QUESTION_MARK 0x3F 0 // ?
#define UC_TILDE 0x7E 0 // ~
#define UC_VERTICAL_LINE 0x7C 0     // |
#define UC_COLON 0x3A 0     // :
#define UC_SEMICOLON 0x3B 0     // ;
#define UC_FULL_STOP             0x2E  0     // .
#define UC_APOSTROPHE            0x27  0     // '
#define UC_QUOTATION_MARK        0x22  0     // "
#define UC_COMMA                 0x2C  0     // ,
#define UC_SOLIDUS               0x2F  0     // /
#define UC_GRAVE_ACCENT          0x60  0     // `

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&uc {
    default-mode = <UC_MODE_WIN_COMPOSE>;  // Default to Linux input system
    minimum-length = <0>;            // Set to desired minimum input length
    //  linux-key = <LC(LS(U))>;         // Overwrite Linux compose key

    win-compose-key = <RCTRL>;        // Overwrite WinCompose compose key
};

/ {
    combos {
        compatible = "zmk,combos";

        cb_func_layer {
            timeout-ms = <25>;
            bindings = <&mo 4>;
            key-positions = <48 53>;
        };

        switch_mode {
            timeout-ms = <25>;
            bindings = <&tog 0>;
            key-positions = <55 11>;
        };

        tilda {
            timeout-ms = <25>;
            bindings = <&kp GRAVE>;
            key-positions = <1 14>;
            layers = <0 2>;
        };

        skoba1 {
            timeout-ms = <25>;
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 27>;
            layers = <0 2>;
        };

        skoba2 {
            timeout-ms = <25>;
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
            layers = <0 2>;
        };

        skoba3 {
            timeout-ms = <25>;
            bindings = <&LEFT_CURLY_BRACKET>;
            key-positions = <16 15>;
            layers = <0 2>;
        };

        skoba_4 {
            timeout-ms = <25>;
            bindings = <&RIGHT_CURLY_BRACKET>;
            key-positions = <19 20>;
        };

        skoba_5 {
            timeout-ms = <25>;
            bindings = <&LEFT_SQUARE_BRACKET>;
            key-positions = <40 39>;
            layers = <0 2>;
        };

        skoba_6 {
            timeout-ms = <25>;
            bindings = <&RIGHT_SQUARE_BRACKET>;
            key-positions = <43 44>;
            layers = <0 2>;
        };

        ctrlC {
            timeout-ms = <25>;
            bindings = <&kp LC(C)>;
            key-positions = <37 39>;
        };

        ctrlX {
            timeout-ms = <25>;
            bindings = <&kp LC(X)>;
            key-positions = <37 38>;
        };

        cttrlV {
            timeout-ms = <25>;
            bindings = <&kp LC(V)>;
            key-positions = <37 40>;
        };

        buttom_ {
            timeout-ms = <25>;
            bindings = <&kp UNDERSCORE>;
            key-positions = <13 14>;
        };

        minusa- {
            timeout-ms = <25>;
            bindings = <&kp MINUS>;
            key-positions = <14 15>;
        };

        lesserThan {
            timeout-ms = <25>;
            bindings = <&lesser>;
            key-positions = <3 4>;
        };

        greaterThan {
            timeout-ms = <25>;
            bindings = <&greater>;
            key-positions = <7 8>;
        };

        space {
            timeout-ms = <25>;
            bindings = <&kp SPACE>;
            key-positions = <26 27>;
        };

        space2 {
            timeout-ms = <25>;
            bindings = <&kp SPACE>;
            key-positions = <33 32>;
        };

        del {
            timeout-ms = <25>;
            bindings = <&kp DELETE>;
            key-positions = <38 39>;
        };

        backspace {
            timeout-ms = <25>;
            bindings = <&kp BACKSPACE>;
            key-positions = <44 45>;
        };

        enter {
            timeout-ms = <25>;
            bindings = <&kp ENTER>;
            key-positions = <20 21>;
        };

        f12 {
            timeout-ms = <25>;
            bindings = <&kp F12>;
            key-positions = <10 11>;
        };

        l_ctrl {
            timeout-ms = <25>;
            bindings = <&kp LCTRL>;
            key-positions = <50 25>;
        };

        l_alt {
            timeout-ms = <25>;
            bindings = <&kp LEFT_ALT>;
            key-positions = <50 26>;
        };

        l_gui {
            timeout-ms = <25>;
            bindings = <&kp LEFT_GUI>;
            key-positions = <50 27>;
        };

        l_shift {
            timeout-ms = <25>;
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <28 50>;
        };

        r_ctrl {
            timeout-ms = <25>;
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <50 34>;
        };

        r_alt {
            timeout-ms = <25>;
            bindings = <&kp LEFT_ALT>;
            key-positions = <50 33>;
        };

        r_gui {
            timeout-ms = <25>;
            bindings = <&kp LEFT_GUI>;
            key-positions = <50 32>;
        };

        r_shift {
            timeout-ms = <25>;
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <31 50>;
        };

        capslock {
            timeout-ms = <25>;
            bindings = <&kp CAPSLOCK>;
            key-positions = <36 28 31>;
        };

        alt_right_side {
            timeout-ms = <25>;
            bindings = <&kp LEFT_ALT>;
            key-positions = <33 34>;
        };

        shift_right_side {
            timeout-ms = <25>;
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <21 22>;
        };

        ctrl_right_side {
            timeout-ms = <25>;
            bindings = <&kp LCTRL>;
            key-positions = <45 46>;
        };
    };

    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;            
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COPYRIGHT_SYMBOL";
        };

        dollar: dollar {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;               
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_3 &kp KP_N6>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "DOLLAR";
        };

        question: question {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_6 &kp KP_NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "QUESTION";
        };

        tilda: tilda {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "TILDA";
        };

        vertical_line: vertical_line {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "VERTICAL_LINE";
        };

        colon: colon {
            compatible = "zmk,behavior-macro";
            wait-ms = <0>;
            tap-ms = <0>;               
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_5 &kp KP_NUMBER_8>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COLON";
        };

        semicolon: semicolon {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_5 &kp KP_NUMBER_9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "SEMICOLON";
        };

        dot: dot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_4 &kp KP_NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "DOT";
        };

        comma: comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_4 &kp KP_NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COMMA";
        };

        apostrophe: apostrophe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_3 &kp KP_NUMBER_9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "APOSTROPHE";
        };

        quotation_mark: quotation_mark {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_3 &kp KP_NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "QUOTATION_MARK";
        };

        solidus: solidus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_4 &kp KP_NUMBER_7>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "SOLIDUS";
        };

        grave: grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_9 &kp KP_NUMBER_6>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "GRAVE";
        };

        lesser: lesser {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_6 &kp KP_NUMBER_0>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "LESSER";
        };

        greater: greater {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_6 &kp KP_NUMBER_2>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "GREATER";
        };

        LEFT_SQUARE_BRACKET: LEFT_SQUARE_BRACKET {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_9 &kp KP_NUMBER_1>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "LEFT_SQUARE_BRACKET";
        };

        RIGHT_SQUARE_BRACKET: RIGHT_SQUARE_BRACKET {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_9 &kp KP_NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "RIGHT_SQUARE_BRACKET";
        };

        LEFT_CURLY_BRACKET: LEFT_CURLY_BRACKET {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_3>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "LEFT_CURLY_BRACKET";
        };

        RIGHT_CURLY_BRACKET: RIGHT_CURLY_BRACKET {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_NUMBER_1 &kp KP_NUMBER_2 &kp KP_NUMBER_5>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "RIGHT_CURLY_BRACKET";
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54 51 52 55>;
            hold-trigger-on-release;
        };

        hmruc: hmruc {
            compatible = "zmk,behavior-hold-tap";
            label = "HMRUC";
            bindings = <&kp>, <&uc>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54 51 52 55>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <48 49 50 53 54 51 52 55 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52>;
            hold-trigger-on-release;
        };

        hmluc: hmluc {
            compatible = "zmk,behavior-hold-tap";
            label = "HMLUC";
            bindings = <&kp>, <&uc>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <48 49 50 53 54 51 52 55 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Code_3 {
            bindings = <
&kp ESCAPE      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5       &kp NUMBER_6  &kp N7         &kp N8     &kp N9   &kp N0         &kp BACKSLASH
&kp TAB         &kp Q         &kp W         &kp E         &kp R         &kp T        &kp Y         &kp U          &kp I      &kp O    &kp P          &kp LEFT_BRACKET
&kp DELETE      &kp A         &kp S         &kp D         &kp F         &kp G        &kp H         &kp J          &kp K      &kp L    &kp SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z         &kp X         &kp C         &kp V         &kp B        &kp N         &kp M          &kp COMMA  &kp DOT  &kp SLASH      &kp RIGHT_BRACKET
                                            &kp LCTRL     &kp SPACE     &mo 1        &lt 2 ENTER   &kp BACKSPACE
                                                          &mkp RCLK     &mkp LCLK    &mo 3
            >;
        };

        layer_6 {
            bindings = <
&kp ESCAPE      &kp NUMBER_1         &kp NUMBER_2     &kp NUMBER_3      &kp NUMBER_4       &kp N5            &kp NUMBER_6  &kp N7             &kp N8           &kp N9           &kp N0                       &kp NON_US_BACKSLASH
&kp TAB         &kp Q                &kp W            &kp E             &kp R              &kp T             &kp Y         &kp U              &kp I            &kp O            &kp P                        &kp LEFT_BRACKET
&kp DELETE      &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_GUI D   &hml LEFT_SHIFT F  &kp G             &kp H         &hmr LEFT_SHIFT J  &hmr LEFT_GUI K  &hmr LEFT_ALT L  &hmr LEFT_CONTROL SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z                &kp X            &kp C             &kp V              &kp B             &kp N         &kp M              &kp COMMA        &kp DOT          &kp SLASH                    &kp RIGHT_BRACKET
                                                      &kp LEFT_CONTROL  &kp SPACE          &lt 3 CAPSLOCK    &lt 2 ENTER   &kp BACKSPACE
                                                                        &mkp RCLK          &mkp LCLK         &mo 3
            >;
        };

        Code_4 {
            bindings = <
&kp LS(GRAVE)  &kp EXCLAMATION  &kp AT_SIGN   &kp HASH   &kp DOLLAR      &kp PERCENT      &kp CARET             &kp AMPERSAND    &kp ASTERISK     &kp MINUS       &kp EQUAL   &kp NON_US_BACKSLASH
&grave         &kp F1           &kp F2        &kp F3     &kp F4          &kp F5           &kp F6                &kp F7           &kp F8           &kp F9          &kp F10     &kp F11
&tilda         &kp EQUAL        &kp ASTERISK  &kp PLUS   &kp HASH        &solidus         &kp NON_US_BACKSLASH  &kp DOLLAR       &kp EXCLAMATION  &kp UNDERSCORE  &semicolon  &apostrophe
&kp CARET      &kp PERCENT      &colon        &kp MINUS  &vertical_line  &kp AMPERSAND    &kp AT_SIGN           &quotation_mark  &comma           &dot            &question   &kp F12
                                              &trans     &trans          &trans           &trans                &trans
                                                         &trans          &trans           &trans
            >;
        };

        code_mouse_5 {
            bindings = <
&trans  &trans  &trans      &kp PAGE_UP    &trans         &trans            &trans          &trans           &kp PAGE_UP      &trans           &trans           &trans
&trans  &trans  &kp DELETE  &kp UP_ARROW   &kp BACKSPACE  &trans            &greater        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp COLON        &kp SEMICOLON
&trans  &trans  &kp LEFT    &kp DOWN       &kp RIGHT      &msc SCRL_UP      &kp KP_NUMLOCK  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &trans
&trans  &trans  &kp HOME    &kp PAGE_DOWN  &kp END        &msc SCRL_DOWN    &lesser         &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD       &kp COMMA
                            &trans         &trans         &trans            &trans          &trans
                                           &trans         &trans            &trans
            >;
        };

        Game {
            bindings = <
&mkp MB3   &kp Q  &kp LC(LS(A))  &kp N9        &kp N0            &kp MINUS    &kp F6            &kp F7        &kp F8     &kp F9      &kp F10        &kp F11
&kp A      &kp L  &kp U          &kp I         &kp O             &kp P        &kp Y             &kp U         &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&kp SPACE  &kp H  &kp J          &kp K         &kp P             &kp N8       &kp H             &kp J         &kp K      &kp L       &kp SEMICOLON  &kp SQT
&kp F      &kp Z  &kp M          &kp COMMA     &kp DOT           &kp SLASH    &kp N             &kp M         &kp COMMA  &kp PERIOD  &kp SLASH      &kp RIGHT_BRACKET
                                 &kp LEFT_ALT  &kp LEFT_CONTROL  &mo 6        &kp LEFT_CONTROL  &kp LEFT_ALT
                                               &kp LEFT_SHIFT    &mo 5        &kp LEFT_SHIFT
            >;
        };

        Game_1 {
            bindings = <
&trans        &trans  &trans  &trans  &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp Z         &kp N8  &trans  &kp Z   &kp T          &kp Q     &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_3  &trans  &trans  &trans  &kp SEMICOLON  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp F7        &trans  &kp F1  &kp F2  &kp F3         &kp F4    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans         &trans    &trans  &trans
                                      &trans         &trans    &trans
            >;
        };

        Game_2 {
            bindings = <
&trans        &kp NUMBER_1  &trans  &trans  &trans      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_2  &kp Y         &trans  &kp N9  &kp N0      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kt F5        &trans        &trans  &trans  &kp R       &kp NUMBER_1    &trans  &trans  &trans  &trans  &trans  &trans
&kp G         &trans        &trans  &trans  &kp PERIOD  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans      &trans          &trans  &trans
                                            &trans      &trans          &trans
            >;
        };
    };
};
