#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        Hold_tab: Hold_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAB";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        tap_dance_f9: tap_dance_f9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_F9";
            #binding-cells = <0>;
            bindings = <&kp F9>, <&kp LC(F9)>;

            tapping-term-ms = <400>;
        };

        tap_dance_f2: tap_dance_f2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_F2";
            #binding-cells = <0>;
            bindings = <&kp F2>, <&kp LC(F2)>;
        };

        tap_dance_tv_znak: tap_dance_tv_znak {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_TV_ZNAK";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp RIGHT_BRACKET>;
        };

        bh_rus_kavychka: bh_rus_kavychka {
            compatible = "zmk,behavior-hold-tap";
            label = "BH_RUS_KAVYCHKA";
            bindings = <&rus_kavychka>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        bh_mc_cntr_lclick_mouse: bh_mc_cntr_lclick_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "BH_MC_CNTR_LCLICK_MOUSE";
            bindings = <&cntrl_left_click>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        x_y: x_y {
            compatible = "zmk,behavior-input-two-axis";
            label = "X_Y";
            #binding-cells = <1>;
            x-input-code = <0>;
            y-input-code = <1>;
            time-to-max-speed-ms = <150>;
        };

        hold_tab_kp_tog: hold_tab_kp_tog {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAB_KP_TOG";
            bindings = <&kp>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_func_layer3 {
            bindings = <&mo 3>;
            key-positions = <48 53>;
        };

        cb_backspace-delete {
            bindings = <&kp DELETE>;
            key-positions = <11 48>;
        };
    };

    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COPYRIGHT_SYMBOL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Eng {
            bindings = <
&kp GRAVE         &kp N1  &kp N2  &kp N3        &kp N4      &kp N5          &kp N6           &kp N7     &kp N8     &kp N9   &kp N0              &kp BACKSPACE
&kp TAB           &kp Q   &kp W   &kp E         &kp R       &kp T           &kp Y            &kp U      &kp I      &kp O    &kp P               &mt PLUS MINUS
&kp LEFT_SHIFT    &kp A   &kp S   &kp D         &kp F       &kp G           &kp H            &kp J      &kp K      &kp L    &kp SEMICOLON       &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V       &kp B           &kp N            &kp M      &kp COMMA  &kp DOT  &lt 6 LEFT_BRACKET  &kp RIGHT_BRACKET
                                  &kp LEFT_ALT  &kp SPACE   &mo 3           &kp PRINTSCREEN  &kp ENTER
                                                &kp ESCAPE  &kp LEFT_GUI    &lt 4 SLASH
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &dbl_click  &mkp LCLK  &mkp RCLK  &mkp MCLK    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans     &trans     &trans       &trans  &trans
                                       &trans     &trans       &trans
            >;
        };

        digits {
            bindings = <
&tog 2      &kp TILDE  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)    &trans     &trans          &kp NUMBER_0  &trans  &trans    &trans
&kp INSERT  &trans     &trans            &trans            &trans            &trans        &kp PLUS   &kp N7          &kp N8        &kp N9  &kp STAR  &kp CARET
&kp LS(N7)  &trans     &trans            &trans            &trans            &trans        &kp MINUS  &kp N4          &kp N5        &kp N6  &kp FSLH  &kp EQUAL
&trans      &kp GRAVE  &kp BACKSLASH     &trans            &trans            &trans        &kp N0     &kp N1          &kp N2        &kp N3  &kp DOT   &kp ENTER
                                         &kp LS(ENTER)     &trans            &trans        &trans     &lt 0 NUMBER_0
                                                           &trans            &trans        &trans
            >;
        };

        Functions {
            bindings = <
&kp ESCAPE  &kp F1  &kp F2          &kp F3          &kp F4           &kp F4    &kp F5             &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans      &trans  &trans          &kp UP_ARROW    &trans           &trans    &trans             &trans  &trans  &trans  &trans  &trans
&trans      &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans    &trans             &trans  &trans  &trans  &trans  &trans
&trans      &trans  &trans          &trans          &trans           &trans    &trans             &trans  &trans  &trans  &trans  &trans
                                    &trans          &trans           &trans    &copyright_symbol  &trans
                                                    &trans           &trans    &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        AUTO-MOUSE {
            bindings = <
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &dbl_click  &mkp LCLK  &mkp RCLK  &mkp MCLK    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans     &trans     &trans       &trans  &trans
                                       &trans     &trans       &trans
            >;
        };

        Scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };

        Rulemak {
            bindings = <
&kp ESC                          &kp FSLH  &kp STAR            &kp LS(NUMBER_4)  &kp LS(NUMBER_6)     &kp EQUAL    &trans         &trans       &trans              &trans   &trans     &trans
&bh_rus_kavychka 0 LS(NUMBER_2)  &kp Z     &kp SEMI            &kp A             &kp G                &kp U        &kp Q          &kp K        &kp E               &kp S    &kp DOT    &kp I
&kp PLUS                         &kp F     &lt 1 H             &lt 3 C           &lt 2 N              &lt 6 L      &kp X          &lt 2 Y      &lt 3 T             &lt 5 B  &kp J      &kp APOS
&kp MINUS                        &kp P     &lt 5 LEFT_BRACKET  &kp W             &kp D                &kp COMMA    &kp R          &kp V        &tap_dance_tv_znak  &kp O    &kp GRAVE  &trans
                                                               &trans            &rus_cntr_layer_eng  &trans       &kp LS(SLASH)  &lt 0 SLASH
                                                                                 &trans               &trans       &trans
            >;
        };
    };
};
