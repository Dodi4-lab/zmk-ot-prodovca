#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        cb_func_layer {
            bindings = <&mo 0>;
            key-positions = <48 53>;
        };
    };

    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COPYRIGHT_SYMBOL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Eng {
            bindings = <
&kp GRAVE         &kp N1  &kp N2  &kp N3        &kp N4      &kp N5          &kp N6           &kp N7               &kp N8     &kp N9      &kp N0              &kp BACKSPACE
&kp TAB           &kp Y   &kp U   &kp E         &kp R       &kp T           &kp Y            &kp U                &kp I      &kp O       &kp P               &mt PLUS MINUS
&kp LEFT_SHIFT    &kp H   &kp J   &kp K         &kp F       &kp G           &kp H            &kp J                &kp K      &kp L       &kp SEMICOLON       &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V       &kp B           &kp N            &mt RIGHT_BRACKET M  &kp COMMA  &kp PERIOD  &lt 0 LEFT_BRACKET  &mt BACKSLASH SLASH
                                  &kp LEFT_ALT  &kp SPACE   &kp A           &kp PRINTSCREEN  &kp ENTER
                                                &kp ESCAPE  &kp LEFT_GUI    &lt 0 SLASH
            >;
        };
    };
};
