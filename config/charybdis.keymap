#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        cb_func_layer {
            bindings = <&mo 0>;
            key-positions = <48 53>;
        };
    };

    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COPYRIGHT_SYMBOL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Eng {
            bindings = <
&mkp MB3   &kp Q  &kp LC(LS(A))  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)    &kp N6           &kp N7               &kp N8     &kp N9      &kp N0              &kp BACKSPACE
&kp A      &kp L  &kp U          &kp I             &kp O             &kp P               &kp Y            &kp U                &kp I      &kp O       &kp P               &mt PLUS MINUS
&kp SPACE  &kp H  &kp J          &kp K             &kp P             &kp NUMBER_1        &kp H            &kp J                &kp K      &kp L       &kp SEMICOLON       &kp SQT
&kp F      &kp Z  &kp M          &kp COMMA         &kp DOT           &kp SLASH           &kp N            &mt RIGHT_BRACKET M  &kp COMMA  &kp PERIOD  &lt 0 LEFT_BRACKET  &mt BACKSLASH SLASH
                                 &kt LEFT_ALT      &kt LEFT_SHIFT    &kt LCTRL           &kp PRINTSCREEN  &kp ENTER
                                                   &sl 1             &sl 2               &lt 0 SLASH
            >;
        };

        layer_1 {
            bindings = <
&trans        &trans  &trans  &trans  &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp Z         &kp N8  &trans  &kp Z   &kp T          &kp Q     &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_3  &trans  &trans  &trans  &kp SEMICOLON  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp F7        &trans  &kp F1  &kp F2  &kp F3         &kp F4    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans         &trans    &trans  &trans
                                      &trans         &trans    &trans
            >;
        };

        layer_2 {
            bindings = <
&trans        &kp NUMBER_1  &trans  &trans  &trans      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_2  &kp Y         &trans  &kp N9  &kp N0      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kt F5        &trans        &trans  &trans  &kp R       &kp NUMBER_1    &trans  &trans  &trans  &trans  &trans  &trans
&kp G         &trans        &trans  &trans  &kp PERIOD  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans      &trans          &trans  &trans
                                            &trans      &trans          &trans
            >;
        };
    };
};
