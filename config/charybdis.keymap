#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    macros {
        dve_skobki: dve_skobki {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "DVE_SKOBKI";
            wait-ms = <300>;
        };

        mc_dvoeto_ravno: mc_dvoeto_ravno {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp SPACE &kp COLON>,
                <&macro_wait_time 10>,
                <&kp EQUAL &kp SPACE>;

            label = "MC_DVOETO_RAVNO";
        };

        mc_kv_skobki: mc_kv_skobki {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT>;
            label = "MC_KV_SKOBKI";
        };

        mc_eng: mc_eng {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(N8)) &to 0>;
            label = "MC_ENG";
        };

        mc_rus: mc_rus {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LA(N9)) &to 1>;
            label = "MC_RUS";
        };

        mc_comma_space: mc_comma_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA &kp SPACE>;
            label = "MC_COMMA_SPACE";
        };

        mc_figur_skobki: mc_figur_skobki {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "MC_FIGUR_SKOBKI";
        };

        mc_dot_space: mc_dot_space {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_DOT &kp SPACE>;
            label = "MC_DOT_SPACE";
        };

        mc_less_great: mc_less_great {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp GT>;
            label = "MC_LESS_GREAT";
        };

        mc_quick: mc_quick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp O &kp B &kp O &kp L &kp I &kp N>;
            label = "MC_QUICK";
        };

        rus_cntr_layer_eng: rus_cntr_layer_eng {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&to 0>,
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&to 1>;

            label = "RUS_CNTR_LAYER_ENG";
        };

        mc_comma: mc_comma {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COMMA>;
            label = "MC_COMMA";
        };

        rus_kavychka: rus_kavychka {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&kp LS(LA(N8))>,
                <&macro_wait_time 100>,
                <&kp LS(SQT)>,
                <&macro_wait_time 100>,
                <&kp LS(LA(N9))>;

            label = "RUS_KAVYCHKA";
        };

        dbl_click: dbl_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&mkp LCLK>, <&macro_wait_time 100>, <&mkp LCLK>;

            label = "DBL_CLICK";
        };

        mc_dve_kav_odinar: mc_dve_kav_odinar {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "MC_DVE_KAV_ODINAR";
        };

        mc_dve_kavy_dvoynyh: mc_dve_kavy_dvoynyh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
            label = "MC_DVE_KAVY_DVOYNYH";
        };

        cntrl_left_click: cntrl_left_click {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_CONTROL &mkp LCLK>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_CONTROL>;

            label = "CNTRL_LEFT_CLICK";
        };
    };

    behaviors {
        Hold_tab: Hold_tab {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_TAB";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        tap_dance_f9: tap_dance_f9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_F9";
            #binding-cells = <0>;
            bindings = <&kp F9>, <&kp LC(F9)>;

            tapping-term-ms = <400>;
        };

        tap_dance_f2: tap_dance_f2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_F2";
            #binding-cells = <0>;
            bindings = <&kp F2>, <&kp LC(F2)>;
        };

        tap_dance_tv_znak: tap_dance_tv_znak {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_TV_ZNAK";
            #binding-cells = <0>;
            bindings = <&kp M>, <&kp RIGHT_BRACKET>;
        };

        bh_rus_kavychka: bh_rus_kavychka {
            compatible = "zmk,behavior-hold-tap";
            label = "BH_RUS_KAVYCHKA";
            bindings = <&rus_kavychka>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        bh_mc_cntr_lclick_mouse: bh_mc_cntr_lclick_mouse {
            compatible = "zmk,behavior-hold-tap";
            label = "BH_MC_CNTR_LCLICK_MOUSE";
            bindings = <&cntrl_left_click>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "hold-preferred";
        };

        x_y: x_y {
            compatible = "zmk,behavior-input-two-axis";
            label = "X_Y";
            #binding-cells = <1>;
            x-input-code = <0>;
            y-input-code = <1>;
            time-to-max-speed-ms = <150>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cb_dve_skobki {
            bindings = <&dve_skobki>;
            key-positions = <27 28>;
        };

        cb_func_layer {
            bindings = <&mo 5>;
            key-positions = <48 53 49>;
            layers = <8>;
        };

        cb_dvoet_ravno {
            bindings = <&mc_dvoeto_ravno>;
            key-positions = <5 4>;
        };

        cb_cntrl_shift {
            bindings = <&sk LS(LEFT_CONTROL)>;
            key-positions = <50 54>;
        };

        cb_cntrl_alt {
            bindings = <&kp LC(LEFT_ALT)>;
            key-positions = <50 49>;
        };

        cb_cntr_back {
            bindings = <&kp LC(BACKSPACE)>;
            key-positions = <49 53>;
        };

        cb_kv_skobki {
            bindings = <&mc_kv_skobki>;
            key-positions = <15 16>;
        };

        cb_fig_skb {
            bindings = <&mc_figur_skobki>;
            key-positions = <40 39>;
        };

        cb_lkv_skb {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 16>;
        };

        cb_lskb {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <29 28>;
        };

        cb_lfig_skb {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <41 40>;
        };

        cb_rkb_skb {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <18 19>;
        };

        cb_rskb {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <30 31>;
        };

        cb_rfig_skb {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <42 43>;
        };

        cb_dot {
            bindings = <&kp MINUS>;
            key-positions = <31 32>;
        };

        cb_comma_space {
            bindings = <&kp ASTERISK>;
            key-positions = <20 21>;
        };

        cb_comma {
            bindings = <&kp KP_PLUS>;
            key-positions = <19 20>;
        };

        cb_dot_space {
            bindings = <&kp SLASH>;
            key-positions = <32 33>;
        };

        cb_com_space_tb {
            bindings = <&mc_comma_space>;
            key-positions = <51 55>;
        };

        cb_less_great {
            bindings = <&kp EQUAL>;
            key-positions = <44 45>;
        };

        cb_tab {
            bindings = <&kp UNDERSCORE>;
            key-positions = <43 44>;
        };

        cb_power_off {
            bindings = <&kp C_POWER>;
            key-positions = <10 35>;
        };

        cb_semicol {
            bindings = <&kp SEMI>;
            key-positions = <15 14>;
        };

        cb_colon {
            bindings = <&kp LS(SEMI)>;
            key-positions = <26 27>;
        };

        cb_col_equal {
            bindings = <&mc_dvoeto_ravno>;
            key-positions = <38 39>;
        };

        cb_dve_kav_odinar {
            bindings = <&mc_dve_kav_odinar>;
            key-positions = <15 28>;
        };

        mc_dve_kavy_dvoynyh {
            bindings = <&mc_dve_kavy_dvoynyh>;
            key-positions = <40 27>;
        };

        cb_apostr {
            bindings = <&kp SQT>;
            key-positions = <16 27>;
        };

        cb_kavychka {
            bindings = <&kp LS(APOS)>;
            key-positions = <39 28>;
        };

        cv_qust {
            bindings = <&kp QUESTION>;
            key-positions = <31 20>;
        };

        cb_excl {
            bindings = <&kp EXCL>;
            key-positions = <19 32>;
        };

        cb_rus {
            bindings = <&mc_eng>;
            key-positions = <40 38>;
        };

        cb_eng {
            bindings = <&mc_rus>;
            key-positions = <43 45>;
        };

        cb_f13 {
            bindings = <&kp F15>;
            key-positions = <26 28>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Eng {
            bindings = <
&kp ESC                               &kp SLASH  &kp ASTRK  &kp SEMICOLON          &kp LS(SEMICOLON)  &kp EQUAL       &kp LEFT_WIN         &none      &mc_eng        &mc_rus           &Hold_tab QUESTION EXCL  &kp LC(Z)
&Hold_tab DOUBLE_QUOTES SINGLE_QUOTE  &kp Q      &kp W      &kp F                  &kp P              &kp G           &kp J                &kp L      &kp U          &kp Y             &kp P                    &kp BSLH
&kp PLUS                              &kp A      &lt 2 R    &lt 5 S                &lt 4 T            &lt 8 D         &kp H                &lt 4 N    &lt 5 E        &lt 7 I           &kp O                    &none
&kp MINUS                             &kp Z      &lt 7 X    &kp C                  &kp V              &lt 6 B         &kp K                &kp M      &kp LESS_THAN  &kp GREATER_THAN  &kp LS(BACKSLASH)        &kp UNDER
                                                            &Hold_tab LSHFT ENTER  &kp LEFT_CONTROL   &kp LEFT_ALT    &lt 4 COMMA          &lt 3 DOT
                                                                                   &kp BACKSPACE      &kp DELETE      &Hold_tab TAB SPACE
            >;
        };

        Russian {
            bindings = <
&kp ESC                          &kp FSLH  &kp STAR  &kp LS(NUMBER_4)  &kp LS(NUMBER_6)     &kp EQUAL    &trans         &trans              &trans     &trans   &trans     &trans
&bh_rus_kavychka 0 LS(NUMBER_2)  &kp Q     &kp W     &kp E             &kp R                &kp T        &kp Y          &kp U               &kp I      &kp O    &kp P      &kp LBKT
&kp PLUS                         &kp A     &lt 2 S   &lt 5 D           &lt 4 F              &lt 8 G      &kp H          &lt 4 J             &lt 5 K    &lt 7 L  &kp SEMI   &kp APOS
&kp MINUS                        &kp Z     &trans    &kp C             &kp V                &trans       &kp N          &tap_dance_tv_znak  &kp COMMA  &kp DOT  &kp GRAVE  &trans
                                                     &trans            &rus_cntr_layer_eng  &trans       &kp LS(SLASH)  &lt 3 SLASH
                                                                       &trans               &trans       &trans
            >;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &dbl_click  &mkp LCLK  &mkp RCLK  &mkp MCLK    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans     &trans     &trans       &trans  &trans
                                       &trans     &trans       &trans
            >;
        };

        Navigate {
            bindings = <
&tog 3  &trans  &trans  &trans  &trans  &trans    &trans         &trans    &trans    &trans     &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PAGE_UP    &kp HOME  &kp UP    &kp END    &trans            &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &kp LEFT_CONTROL  &kp LEFT_CONTROL
&trans  &trans  &trans  &trans  &trans  &trans    &trans         &trans    &trans    &trans     &trans            &trans
                        &trans  &trans  &trans    &trans         &trans
                                &trans  &trans    &trans
            >;
        };

        digits {
            bindings = <
&tog 4      &kp TILDE  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(N5)    &trans     &trans  &kp NUMBER_0  &trans  &trans    &trans
&kp INSERT  &trans     &trans            &trans            &trans            &trans        &kp PLUS   &kp N7  &kp N8        &kp N9  &kp STAR  &kp CARET
&kp LS(N7)  &trans     &trans            &trans            &trans            &trans        &kp MINUS  &kp N4  &kp N5        &kp N6  &kp FSLH  &kp EQUAL
&trans      &kp GRAVE  &kp BACKSLASH     &trans            &trans            &trans        &kp N0     &kp N1  &kp N2        &kp N3  &kp DOT   &kp ENTER
                                         &kp LS(ENTER)     &trans            &trans        &trans     &trans
                                                           &trans            &trans        &trans
            >;
        };

        Functions {
            bindings = <
&tog 5      &trans         &trans               &trans   &trans   &kp LA(F4)              &trans  &trans                &trans                &kp PRINTSCREEN       &kp LA(PRINTSCREEN)   &trans
&trans      &kp F1         &Hold_tab LC(F2) F2  &kp F3   &kp F4   &kp LA(LC(NUMBER_2))    &trans  &trans                &kp LC(F12)           &trans                &trans                &kp LC(RIGHT_BRACKET)
&kp LC(F5)  &kp F5         &kp F6               &kp F7   &kp F8   &kp LC(LS(UP))          &trans  &kp LS(LC(NUMBER_1))  &kp LS(LC(NUMBER_2))  &kp LC(LS(NUMBER_3))  &kp LS(LC(NUMBER_4))  &kp LS(LC(N5))
&mc_quick   &tap_dance_f9  &kp F10              &kp F11  &kp F12  &kp LS(LC(DOWN))        &trans  &kp LC(NUMBER_1)      &kp LC(NUMBER_2)      &kp LC(NUMBER_3)      &kp LC(NUMBER_4)      &kp LC(NUMBER_5)
                                                &trans   &trans   &trans                  &trans  &trans
                                                         &trans   &trans                  &trans
            >;
        };

        BT_layers {
            bindings = <
&trans  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR_ALL  &trans        &trans        &trans        &trans          &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans          &trans        &bt BT_CLR    &trans        &trans          &bt BT_NXT  &trans  &trans  &trans  &trans  &trans
                                      &trans        &trans        &trans          &trans      &trans
                                                    &trans        &trans          &trans
            >;
        };

        AUTO-MOUSE {
            bindings = <
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans     &trans     &trans       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &dbl_click  &mkp LCLK  &mkp RCLK  &mkp MCLK    &trans  &trans  &trans  &trans  &trans  &trans
                            &trans     &trans     &trans       &trans  &trans
                                       &trans     &trans       &trans
            >;
        };

        Scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
