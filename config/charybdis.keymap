#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {


    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

        };
    };

    keymap {
        compatible = "zmk,keymap";

        Code_3 {
            bindings = <
<<<<<<< Charybdis_4x6
&kp ESCAPE      &kp NUMBER_1    &kp NUMBER_2    &kp NUMBER_3      &kp NUMBER_4  &kp N5            &kp NUMBER_6  &kp N7         &kp N8        &kp N9           &kp N0                   &kp NON_US_BACKSLASH
&kp TAB         &kp Q           &kp W           &kp E             &kp R         &kp T             &kp Y         &kp U          &kp I         &kp O            &kp P                    &kp LEFT_BRACKET
&kp DELETE      &mt LEFT_GUI A  &mt LEFT_ALT S  &mt LEFT_SHIFT D  &mt LCTRL F   &kp G             &kp H         &mt RCTRL J    &mt RSHIFT K  &mt RIGHT_ALT L  &mt RIGHT_GUI SEMICOLON  &kp APOSTROPHE
&kp LEFT_SHIFT  &kp Z           &kp X           &kp C             &kp V         &kp B             &kp N         &kp M          &kp COMMA     &kp DOT          &kp SLASH                &kp RIGHT_BRACKET
                                                &kp TAB           &kp SPACE     &lt 2 LEFT_GUI    &lt 1 ENTER   &kp BACKSPACE
                                                                  &mkp RCLK     &mkp LCLK         &mo 2
=======
&kp GRAVE         &kp N1  &kp N2  &kp N3        &kp N4      &mt F5 N5       &kp N6           &kp N7               &kp N8     &kp N9      &kp N0              &kp BACKSPACE
&kp TAB           &kp Q   &kp W   &kp E         &kp R       &kp T           &kp Y            &kp U                &kp I      &kp O       &kp P               &mt PLUS MINUS
&kp LEFT_SHIFT    &kp A   &kp S   &kp D         &kp F       &kp G           &kp H            &kp J                &kp K      &kp L       &kp SEMICOLON       &kp SQT
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C         &kp V       &kp B           &kp N            &mt RIGHT_BRACKET M  &kp COMMA  &kp PERIOD  &lt 5 LEFT_BRACKET  &mt BACKSLASH SLASH
                                  &kp LEFT_ALT  &kp SPACE   &mo 1           &kp PRINTSCREEN  &kp ENTER
                                                &kp ESCAPE  &kp LEFT_GUI    &lt 3 SLASH
>>>>>>> Charybdis_4x6
            >;
        };

        Code_4 {
            bindings = <
&kp GRAVE   &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT           &kp CARET  &kp AMPERSAND    &kp ASTERISK     &kp F9           &kp F10          &kp F11
&kp ESCAPE  &kp F1           &kp F2       &kp F3    &kp F4      &kp F5                &kp F6     &kp F7           &kp F8           &kp F9           &kp F10          &kp F11
&trans      &trans           &kp COLON    &kp PLUS  &kp SLASH   &trans                &trans     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &kp F12
&trans      &trans           &trans       &trans    &trans      &kp LA(LEFT_SHIFT)    &trans     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOT          &trans
                                          &trans    &trans      &trans                &trans     &trans
                                                    &trans      &trans                &trans
            >;
        };

        code_mouse_5 {
            bindings = <
&trans  &trans  &trans  &trans         &trans      &trans            &trans    &trans    &kp PAGE_UP    &trans     &trans   &trans
&kp F1  &kp F2  &kp F3  &kp F4         &kp F5      &kp F6            &kp F7    &kp F8    &kp F9         &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &mkp LCLK      &mkp RCLK   &msc SCRL_UP      &kp HOME  &kp LEFT  &kp DOWN       &kp RIGHT  &kp END  &trans
&trans  &trans  &trans  &kp BACKSPACE  &kp DELETE  &msc SCRL_DOWN    &trans    &trans    &kp PAGE_DOWN  &trans     &trans   &trans
                        &trans         &trans      &trans            &trans    &trans
                                       &trans      &trans            &trans
            >;
        };

        Game {
            bindings = <
&mkp MB3   &kp Q  &kp LC(LS(A))  &kp N9        &kp N0            &kp MINUS    &kp F6            &kp F7        &kp F8     &kp F9      &kp F10        &kp F11
&kp A      &kp L  &kp U          &kp I         &kp O             &kp P        &kp Y             &kp U         &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&kp SPACE  &kp H  &kp J          &kp K         &kp P             &kp N8       &kp H             &kp J         &kp K      &kp L       &kp SEMICOLON  &kp SQT
&kp F      &kp Z  &kp M          &kp COMMA     &kp DOT           &kp SLASH    &kp N             &kp M         &kp COMMA  &kp PERIOD  &kp SLASH      &kp RIGHT_BRACKET
                                 &kp LEFT_ALT  &kp LEFT_CONTROL  &mo 5        &kp LEFT_CONTROL  &kp LEFT_ALT
                                               &kp LEFT_SHIFT    &mo 4        &kp LEFT_SHIFT
            >;
        };

        Game_1 {
            bindings = <
&trans        &trans  &trans  &trans  &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp Z         &kp N8  &trans  &kp Z   &kp T          &kp Q     &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_3  &trans  &trans  &trans  &kp SEMICOLON  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp F7        &trans  &kp F1  &kp F2  &kp F3         &kp F4    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans         &trans    &trans  &trans
                                      &trans         &trans    &trans
            >;
        };

        Game_2 {
            bindings = <
&trans        &kp NUMBER_1  &trans  &trans  &trans      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_2  &kp Y         &trans  &kp N9  &kp N0      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kt F5        &trans        &trans  &trans  &kp R       &kp NUMBER_1    &trans  &trans  &trans  &trans  &trans  &trans
&kp G         &trans        &trans  &trans  &kp PERIOD  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans      &trans          &trans  &trans
                                            &trans      &trans          &trans
            >;
        };
    };
};
