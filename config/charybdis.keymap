#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        cb_func_layer {
            bindings = <&mo 0>;
            key-positions = <48 53>;
        };

        switch_mode {
            bindings = <&tog 3>;
            key-positions = <55 11>;
        };

        tilda {
            bindings = <&kp GRAVE>;
            key-positions = <1 14>;
            layers = <3 4>;
        };

        skoba1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 27>;
            layers = <3 4>;
        };

        skoba2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <31 32>;
            layers = <3 4>;
        };

        skoba3 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 15>;
            layers = <3 4>;
        };

        skoba_4 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <19 20>;
        };

        skoba_5 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <40 39>;
            layers = <3 4>;
        };

        skoba_6 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <43 44>;
            layers = <3 4>;
        };

        ctrlC {
            bindings = <&kp LC(C)>;
            key-positions = <37 39>;
        };

        ctrlX {
            bindings = <&kp LC(X)>;
            key-positions = <37 38>;
        };

        cttrlV {
            bindings = <&kp LC(V)>;
            key-positions = <37 40>;
        };

        ctrlZ {
            bindings = <&kp LC(Z)>;
            key-positions = <25 26>;
        };

        shiftCtrlZ {
            bindings = <&kp LS(LC(Z))>;
            key-positions = <26 27>;
        };

        buttom_ {
            bindings = <&kp UNDERSCORE>;
            key-positions = <38 39>;
        };

        minusa- {
            bindings = <&kp MINUS>;
            key-positions = <14 15>;
        };

        lcm {
            bindings = <&mkp LCLK>;
            key-positions = <50 27>;
        };

        rcm {
            bindings = <&mkp RCLK>;
            key-positions = <50 28>;
        };

        lesserThan {
            bindings = <&kp LESS_THAN>;
            key-positions = <3 4>;
        };

        greaterThan {
            bindings = <&kp GREATER_THAN>;
            key-positions = <7 8>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <26 27>;
        };

        space2 {
            bindings = <&kp SPACE>;
            key-positions = <33 32>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <38 39>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <44 45>;
        };
    };

    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COPYRIGHT_SYMBOL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Game {
            bindings = <
&mkp MB3   &kp Q  &kp LC(LS(A))  &kp N9        &kp N0            &kp MINUS    &kp F6            &kp F7        &kp F8     &kp F9      &kp F10        &kp F11
&kp A      &kp L  &kp U          &kp I         &kp O             &kp P        &kp Y             &kp U         &kp I      &kp O       &kp P          &kp LEFT_BRACKET
&kp SPACE  &kp H  &kp J          &kp K         &kp P             &kp N8       &kp H             &kp J         &kp K      &kp L       &kp SEMICOLON  &kp SQT
&kp F      &kp Z  &kp M          &kp COMMA     &kp DOT           &kp SLASH    &kp N             &kp M         &kp COMMA  &kp PERIOD  &kp SLASH      &kp RIGHT_BRACKET
                                 &kp LEFT_ALT  &kp LEFT_SHIFT    &mo 2        &kp LEFT_CONTROL  &kp LEFT_ALT
                                               &kp LEFT_CONTROL  &mo 1        &kp LEFT_SHIFT
            >;
        };

        Game_1 {
            bindings = <
&trans        &trans  &trans  &trans  &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp Z         &kp N8  &trans  &kp Z   &kp T          &kp Q     &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_3  &trans  &trans  &trans  &kp SEMICOLON  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp F7        &trans  &kp F1  &kp F2  &kp F3         &kp F4    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans         &trans    &trans  &trans
                                      &trans         &trans    &trans
            >;
        };

        Game_2 {
            bindings = <
&trans        &kp NUMBER_1  &trans  &trans  &trans      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_2  &kp Y         &trans  &kp N9  &kp N0      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kt F5        &trans        &trans  &trans  &kp R       &kp NUMBER_1    &trans  &trans  &trans  &trans  &trans  &trans
&kp G         &trans        &trans  &trans  &kp PERIOD  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans      &trans          &trans  &trans
                                            &trans      &trans          &trans
            >;
        };

        Code_3 {
            bindings = <
&kp ESCAPE        &kp F1  &kp F2  &kp F3   &kp F4         &kp F5    &trans  &trans  &trans  &trans  &trans  &trans
&kp TAB           &kp Q   &kp W   &kp E    &kp R          &kp T     &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_ALT      &kp A   &kp S   &kp D    &kp F          &kp G     &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_CONTROL  &kp Z   &kp X   &kp C    &kp V          &kp B     &trans  &trans  &trans  &trans  &trans  &trans
                                  &kp TAB  &kp BACKSPACE  &mo 5     &trans  &trans
                                           &kp DELETE     &mo 4     &trans
            >;
        };

        Code_4 {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT_SIGN    &kp HASH              &kp DOLLAR  &kp PERCENT           &kp CARET       &kp AMPERSAND    &kp ASTERISK     &kp F9           &kp F10          &kp F11
&trans  &trans           &kp SEMICOLON  &kp NON_US_BACKSLASH  &kp EQUAL   &trans                &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans           &kp F12
&trans  &trans           &kp COLON      &kp PLUS              &kp SLASH   &trans                &trans          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &trans
&trans  &trans           &trans         &trans                &trans      &kp LA(LEFT_SHIFT)    &trans          &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp DOT          &trans
                                        &trans                &trans      &trans                &trans          &trans
                                                              &trans      &trans                &trans
            >;
        };

        code_mouse_5 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans            &trans    &trans    &kp PAGE_UP    &trans     &trans   &trans
&trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &msc SCRL_UP      &trans    &trans    &kp UP_ARROW   &trans     &trans   &trans
&trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &msc SCRL_DOWN    &kp HOME  &kp LEFT  &kp DOWN       &kp RIGHT  &kp END  &trans
&trans  &trans  &trans  &trans     &trans     &trans            &trans    &trans    &kp PAGE_DOWN  &trans     &trans   &trans
                        &trans     &trans     &trans            &trans    &trans
                                   &trans     &trans            &trans
            >;
        };
    };
};
