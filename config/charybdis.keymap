#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define CHARYBDIS_AUTO_SNIPING_ON_LAYER 2

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos {
        compatible = "zmk,combos";

        cb_func_layer {
            bindings = <&mo 0>;
            key-positions = <48 53>;
        };

        switch_mode {
            bindings = <&tog 3>;
            key-positions = <55 11>;
        };

        tilda {
            bindings = <&kp GRAVE>;
            key-positions = <1 14>;
            layers = <3 4>;
        };

        skoba1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <28 29>;
            layers = <3 4>;
        };

        skoba2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <30 31>;
            layers = <3 4>;
        };

        skoba3 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <16 17>;
            layers = <3 4>;
        };

        skoba_4 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <18 19>;
        };

        skoba_5 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <40 41>;
            layers = <3 4>;
        };

        skoba_6 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <42 43>;
            layers = <3 4>;
        };
    };

    macros {
        copyright_symbol: copyright_symbol {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0 &kp KP_N1 &kp KP_N6 &kp KP_N9>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "COPYRIGHT_SYMBOL";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Game {
            bindings = <
&mkp MB3   &kp Q  &kp LC(LS(A))  &kp N9        &kp N0          &kp MINUS    &kp N6         &kp N7               &kp N8     &kp N9      &kp N0              &kp BACKSPACE
&kp A      &kp L  &kp U          &kp I         &kp O           &kp P        &kp Y          &kp U                &kp I      &kp O       &kp P               &mt PLUS MINUS
&kp SPACE  &kp H  &kp J          &kp K         &kp P           &kp N8       &kp H          &kp J                &kp K      &kp L       &kp SEMICOLON       &kp LA(LC(S))
&kp F      &kp Z  &kp M          &kp COMMA     &kp DOT         &kp SLASH    &kp N          &mt RIGHT_BRACKET M  &kp COMMA  &kp PERIOD  &lt 0 LEFT_BRACKET  &kp LC(LA(Q))
                                 &kp LEFT_ALT  &kp LEFT_SHIFT  &mo 2        &kp BACKSPACE  &kp ENTER
                                               &kp LCTRL       &mo 1        &kp DELETE
            >;
        };

        Game_1 {
            bindings = <
&trans        &trans  &trans  &trans  &trans         &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp Z         &kp N8  &trans  &kp Z   &kp T          &kp Q     &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_3  &trans  &trans  &trans  &kp SEMICOLON  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&kp F7        &trans  &kp F1  &kp F2  &kp F3         &kp F4    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans  &trans         &trans    &trans  &trans
                                      &trans         &trans    &trans
            >;
        };

        Game_2 {
            bindings = <
&trans        &kp NUMBER_1  &trans  &trans  &trans      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kp NUMBER_2  &kp Y         &trans  &kp N9  &kp N0      &trans          &trans  &trans  &trans  &trans  &trans  &trans
&kt F5        &trans        &trans  &trans  &kp R       &kp NUMBER_1    &trans  &trans  &trans  &trans  &trans  &trans
&kp G         &trans        &trans  &trans  &kp PERIOD  &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                    &trans  &trans      &trans          &trans  &trans
                                            &trans      &trans          &trans
            >;
        };

        Code_3 {
            bindings = <
&kp ESCAPE    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &kp N5    &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_ALT  &kp Q         &kp W         &kp E         &kp R           &kp T     &trans  &trans  &trans  &trans  &trans  &trans
&trans        &kp A         &kp S         &kp D         &kp F           &kp G     &trans  &trans  &trans  &trans  &trans  &trans
&trans        &kp Z         &kp X         &kp C         &kp V           &kp B     &trans  &trans  &trans  &trans  &trans  &trans
                                          &kp LCTRL     &kp LEFT_ALT    &mo 5     &trans  &trans
                                                        &kp LEFT_SHIFT  &mo 4     &trans
            >;
        };

        Code_4 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5    &kp F6          &kp F7           &kp F8           &kp F9           &kp F10          &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &kp KP_NUMLOCK  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans           &kp F12
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans          &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp DOT          &trans
                        &trans  &trans  &trans    &trans          &trans
                                &trans  &trans    &trans
            >;
        };

        code_mouse_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &trans    &kp PAGE_UP    &trans     &trans  &trans
&trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK    &trans  &trans    &kp UP_ARROW   &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &kp LEFT  &kp DOWN       &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans     &trans       &trans  &trans    &kp PAGE_DOWN  &trans     &trans  &trans
                        &trans  &trans     &trans       &trans  &trans
                                &trans     &trans       &trans
            >;
        };
    };
};
